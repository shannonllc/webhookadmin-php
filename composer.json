{
  "name": "shannonllc/webhookadmin",
  "description": "PHP SDK for Webhook Admin: send webhooks, manage endpoints and verify signatures.",
  "type": "library",
  "license": "MIT",
  "keywords": ["webhook", "webhooks", "standard-webhooks", "webhookadmin", "sdk"],
  "homepage": "https://webhookadmin.com/docs/",
  "authors": [{ "name": "SHANNON LIMITED LIABILITY COMPANY" }],
  "support": {
    "docs": "https://webhookadmin.com/docs/sdk/",
    "issues": "https://github.com/shannonllc/webhookadmin-php/issues",
    "source": "https://github.com/shannonllc/webhookadmin-php"
  },
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
  },
  "autoload": {
    "psr-4": { "WebhookAdmin\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "WebhookAdmin\\Tests\\": "tests/" }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
